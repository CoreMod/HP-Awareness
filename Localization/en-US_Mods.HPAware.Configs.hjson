Modconfig: {
	DisplayName: Configuration

	Headers: {
		Hurt: "[i:29] Hurt Overlay"
		Low: "[i:29] Low HP Overlay"
		Bar: "[i:705] Player HP Bar"
		Potion: "[i:28] Potion Pop Up"
		Debuff:
			'''
			[i:2701] Debuff Pop Up
			(NOTE: Fargo's Mutant Mod adds a similar feature. If these don't seem to work, check their config)
			'''
		Gray: "[i:1099] Gray Vision"
	}

	DisableMLShader: {
		Label: Disable Moon Lord Shader
		Tooltip:
			'''
			Moon Lord's shader may cause the 2 overlays below to be invisible
			Check the box to disable
			'''
	}

	# Hurt Overlay ----------------------------------------------
	EnableHurtOverlay: {
		Label: Enable Hurt Overlay
		Tooltip: When damaged, overlay makes the edges of the screen red before quickly disappearing
	}

	HurtOverlayType: {
		Label: Overlay to use
		Tooltip:
			'''
			Determines overlay type 
			HPOverlay - Single color, covers screen edges (Retro/trippy lighting default)
			New - Gradient, covers screen edges (Color/white lighting mode only)
			Flat - Single color, fills screen
			'''
	}

	HurtColor: {
		Label: "[i:1073] Overlay Color"
		Tooltip: Note: Alpha values have no effect unless using retro/trippy lighting
	}

	HurtUseDarkColors: {
		Label: "[i:1085] Use Darker Colors"
		Tooltip:
			'''
			Experimental
			Unsupported on retro/trippy lighting
			Set alpha to 255 for most accurate view (still has no effect on shader)
			White = Transparent
			'''
	}

	HurtAlpha: {
		Label: Overlay intensity
		Tooltip:
			'''
			Determines overlay color intensity
			Higher = More intense
			'''
	}

	HurtSpeed: {
		Label: Overlay fade speed
		Tooltip:
			'''
			Determines how fast the overlay disappears
			Higher = Quicker
			'''
	}

	HaveIntensity: {
		Label: Use variable intensity
		Tooltip:
			'''
			Experimental
			Hurt overlay's intensity fluctuates depending on how often you get hurt
			Recommended with higher intensity values
			Color/white lighting mode only
			'''
	}

	# Low HP Overlay ----------------------------------------------
	EnableLowHpOverlay: {
		Label: Enable Low HP Overlay
		Tooltip: When active, overlay makes the edges of the screen pulsate red
	}

	ClassicLowHpOverlay: {
		Label: Use Classic Low HP Overlay
		Tooltip:
			'''
			Instead of a gradient, it is a single color
			Retro/trippy lighting default
			'''
	}

	LowHpColor: {
		Label: "{$HurtColor.Label}"
		Tooltip: "{$HurtColor.Tooltip}"
	}

	LowHpUseDarkColors: {
		Label: "{$HurtUseDarkColors.Label}"
		Tooltip: "{$HurtUseDarkColors.Tooltip}"
	}

	Overlaytrigger: {
		Label: Low HP Percentage
		Tooltip: Having HP lower or equal to this percentage activates overlay & sound
	}

	LowHpAlpha: {
		Label: Overlay intensity
		Tooltip:
			'''
			Determines overlay color intensity
			Higher = More intense
			'''
	}

	LowHpFlash: {
		Label: Overlay flashing rate
		Tooltip:
			'''
			Determines rate of flashing
			Higher = More flashing
			0 = No flashing
			'''
	}

	EnableLowHpAudio: {
		Label: "[i:5117] Enable Audio"
		Tooltip:
			'''
			When active, a sound plays repeatedly
			Disabled by default
			'''
	}

	LowHpSound: {
		Label: "[i:5117] Sound to use"
		Tooltip:
			'''
			Determines sound
			See workshop page for custom sounds
			'''
	}

	LowHpSdFreq: {
		Label: "[i:5117] Sound frequency"
		Tooltip:
			'''
			Determines how often the sound plays (in ticks)
			Lower = More often
			60 ticks = 1 second
			'''
	}

	# Gray Vision ----------------------------------------------
	EnableGrayVision: {
		Label: Enable Gray Vision
		Tooltip:
			'''
			When active, screen turns gray the lower your health
			Also applies to above overlays
			Requires Color/White lighting
			Disabled by default
			'''
	}

	GrayTrigger: {
		Label: Start Percentage
		Tooltip: Having HP lower or equal to this percentage starts vision
	}

	GrayMaxIntensity: {
		Label: Max Intensity
		Tooltip:
			'''
			Determines maximum vision intensity at 0-1% HP
			Higher = More intense
			'''
	}

	# HP Bar ----------------------------------------------
	EnableHPBar: {
		Label: Enable player HP Bar
		Tooltip: When damaged, this appears below you much like every other HP bar
	}

	HPBarDelay: {
		Label: Bar Duration
		Tooltip:
			'''
			Determines how long it lingers on screen (in ticks)
			60 ticks = 1 second
			Set to 610 ticks for infinite
			'''
	}

	HPBarOpacity: {
		Label: Bar Opacity
		Tooltip: Determines bar transparency
	}

	HPBarScale: {
		Label: Bar Scale
		Tooltip: Determines bar size
	}

	# Potion Pop Up ----------------------------------------------
	EnablePSAudio: {
		Label: Enable Potion Sickness Audio
		Tooltip: Plays a higher-pitched potion-drink sound effect when potion sickness disappears
	}

	EnablePSVisual: {
		Label: Enable Potion Sickness Visual
		Tooltip: A potion icon will appear above the player when potion sickness disappears
	}

	PotionDelay: {
		Label: Visual Duration
		Tooltip:
			'''
			Determines how long icon lingers on screen (in ticks)
			60 ticks = 1 second
			'''
	}

	PotionOpacity: {
		Label: Icon Opacity
		Tooltip:
			'''
			Determines transparency of the icon
			255 = Fully visible
			0 = Invisible
			'''
	}

	PotionScale: {
		Label: Icon Scale
		Tooltip: Determines icon size
	}

	# Debuff Pop Up ----------------------------------------------
	EnableBuffVisual: {
		Label: Enable Debuff Pop Ups
		Tooltip: When you get a debuff, the debuff's icon(s) will appear above the player for a second
	}

	BuffLayout: {
		Label: Layout to use
		Tooltip:
			'''
			Determines icon layout
			Most recent only - shows the most recently gained debuff
			Other two show every current debuff in an orientation
			'''
	}

	EnableBuffTimer: {
		Label: Show Debuff Duration
		Tooltip:
			'''
			Debuff icons will have their duration placed on top of them
			Disabled by default
			'''
	}

	BuffDelay: {
		Label: Icon Duration
		Tooltip:
			'''
			Determines how long icon(s) linger on screen (in ticks)
			60 ticks = 1 second
			Set to 610 ticks for infinite
			'''
	}

	BuffOpacity: {
		Label: Icon Opacity
		Tooltip:
			'''
			Determines transparency of the icon(s)
			255 = Fully visible
			0 = Invisible
			'''
	}

	BuffScale: {
		Label: Icon Scale
		Tooltip: Determines icon size(s)
	}

	EnableEasyAddToBL: {
		Label: "[i:2701] Allow adding to Blacklist by right-clicking icons"
		Tooltip:
			'''
			Lets you right-click debuff icons in-game to add them to list below
			Once enabled, debuffs indicated by [i:2701] are not in the list
			'''
	}

	DebuffBL: {
		Label: Debuff Blacklist
		Tooltip:
			'''
			Any debuffs in this list will NOT have a pop up
			Use with feature above
			'''
	}
}

NBuffList: {
	DisplayName: Debuff List
	Headers.List:
		'''
		[c/FFFF00:You don't need to touch this unless you know what you are doing.]
		Copy & paste desired debuffs below over to blacklist.
		Must be in-world to view, use restore defaults to refresh list.
		For more info, find the debuff blacklist guide on this mod's Workshop page.
		'''

	DebuffList: {
		Label: Debuffs
		Tooltip: ""
	}
}

DebuffList: {
	Debuffs: {
		Label: ""
		Tooltip: ""
	}

	Tooltip: ""
}
